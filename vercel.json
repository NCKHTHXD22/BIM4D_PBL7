{
  "headers": [
    { "source": "/models/(.*)", "headers": [ { "key": "Content-Type", "value": "model/gltf-binary" }, { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
    { "source": "/vendor/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800, immutable" } ] }
  ]
}
